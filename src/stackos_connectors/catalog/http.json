{
  "schema_version": "stackos.connector.v1",
  "connector": "http",
  "name": "http",
  "description": "Execute explicitly registered HTTP requests.",
  "auth_methods": [
    {
      "key": "bearer",
      "description": "bearer authentication for an explicitly registered HTTP action.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "config_schema": {
        "type": "object"
      },
      "payload_format": "raw",
      "payload_field": "token"
    },
    {
      "key": "header",
      "description": "header authentication for an explicitly registered HTTP action.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "config_schema": {
        "type": "object"
      },
      "payload_format": "raw",
      "payload_field": "token"
    },
    {
      "key": "basic",
      "description": "basic authentication for an explicitly registered HTTP action.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "config_schema": {
        "type": "object"
      },
      "payload_format": "json"
    }
  ],
  "actions": [],
  "setup": {},
  "implementation": "stackos_connectors.actions.http:HttpActionConnector",
  "guidance": "Register named ActionDefinition values with fixed http routing/configuration on an isolated ConnectorClient. No per-call route override is accepted."
}
