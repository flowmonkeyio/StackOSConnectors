{
  "schema_version": "stackos.connector.v1",
  "connector": "google-veo",
  "name": "Google Veo",
  "description": "Google Gemini API Veo video generation provider.",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Supply API key credentials.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "fields": [
          {
            "description": null,
            "key": "api_key",
            "label": "Gemini API Key",
            "options": null,
            "placeholder": null,
            "required": true,
            "secret": true,
            "type": "secret"
          }
        ],
        "description": "Supply API key credentials."
      }
    }
  ],
  "actions": [
    {
      "key": "google.video.generate",
      "operation": "video.generate",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "enum": [
              "veo-3.1-generate-preview",
              "veo-3.1-fast-generate-preview",
              "veo-3.1-lite-generate-preview"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "text-to-video",
              "image-to-video",
              "first-last-frame"
            ],
            "type": "string"
          },
          "duration_seconds": {
            "enum": [
              4,
              6,
              8
            ],
            "type": "integer"
          },
          "aspect_ratio": {
            "enum": [
              "16:9",
              "9:16"
            ],
            "type": "string"
          },
          "resolution": {
            "enum": [
              "720p",
              "1080p",
              "4k"
            ],
            "type": "string"
          },
          "input_image_path": {
            "type": "string",
            "description": "Caller-provided local file path."
          },
          "last_frame_path": {
            "type": "string",
            "description": "Caller-provided local file path."
          },
          "enhance_prompt": {
            "type": "boolean"
          },
          "person_generation": {
            "enum": [
              "allow_all",
              "allow_adult"
            ],
            "type": "string"
          },
          "seed": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "poll_interval_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "poll_timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "prompt",
          "model",
          "mode",
          "aspect_ratio",
          "poll_interval_seconds",
          "poll_timeout_seconds"
        ]
      },
      "output_schema": {
        "additionalProperties": true,
        "properties": {
          "data": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "file_format": {
                  "enum": [
                    "mp4"
                  ],
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "source_model": {
                  "type": "string"
                },
                "path": {
                  "type": "string",
                  "description": "Path of the output file in the caller-provided output directory."
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "config": {},
      "description": "Generate Google Veo Video. Supply native inputs and an output directory for downloaded media.",
      "metadata": {
        "name": "Generate Google Veo Video"
      }
    }
  ],
  "setup": {
    "billing_url": "https://console.cloud.google.com/billing",
    "console_url": "https://aistudio.google.com/",
    "credential_label": "Gemini API key",
    "credential_url": "https://aistudio.google.com/app/apikey",
    "docs_url": "https://ai.google.dev/gemini-api/docs/video-generation",
    "fallback_url": "https://ai.google.dev/gemini-api/docs/video",
    "homepage_url": "https://ai.google.dev/",
    "signup_url": "https://aistudio.google.com/",
    "setup_note": "Obtain the provider credentials and supply the resolved execution fields for each call.",
    "docs": [
      "https://ai.google.dev/gemini-api/docs/pricing",
      "https://github.com/googleapis/python-genai"
    ]
  },
  "icon": {
    "path": "connectors/google_veo/assets/icon.png",
    "media_type": "image/png",
    "kind": "icon"
  },
  "implementation": "stackos_connectors.connectors.google_veo.actions:MediaActionConnector"
}
