{
  "schema_version": "stackos.connector.v1",
  "connector": "firecrawl",
  "probe_implementation": "stackos_connectors.connectors.firecrawl.integration:FirecrawlIntegration",
  "name": "Firecrawl",
  "description": "Web crawling and scraping provider.",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Supply the Firecrawl API key.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "description": "API Key",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "fields": [
          {
            "description": null,
            "key": "api_key",
            "label": "API Key",
            "options": null,
            "placeholder": "fc-...",
            "required": true,
            "secret": true,
            "type": "secret"
          }
        ],
        "description": "Supply the Firecrawl API key for scrape, crawl, and map requests. Create or copy an API key in the Firecrawl app; provider plan limits apply."
      }
    }
  ],
  "actions": [
    {
      "key": "web.scrape",
      "operation": "scrape",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "formats": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "only_main_content": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "description": "Fetch and normalize a web page.",
      "metadata": {
        "capability": "web-retrieval",
        "name": "Scrape Web Page",
        "risk_level": "read"
      }
    },
    {
      "key": "web.crawl",
      "operation": "crawl",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer"
          },
          "max_depth": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "description": "Start a bounded Firecrawl crawl for an agent-selected site.",
      "metadata": {
        "capability": "web-retrieval",
        "name": "Crawl Website",
        "risk_level": "cost"
      }
    },
    {
      "key": "web.map",
      "operation": "map",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "search": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "description": "Discover URLs from an agent-selected site.",
      "metadata": {
        "capability": "web-retrieval",
        "name": "Map Website URLs",
        "risk_level": "cost"
      }
    }
  ],
  "setup": {
    "billing_url": "https://www.firecrawl.dev/pricing",
    "console_url": "https://app.firecrawl.dev/",
    "credential_label": "Firecrawl API key",
    "credential_url": "https://app.firecrawl.dev/",
    "docs_url": "https://docs.firecrawl.dev/",
    "fallback_reason": "Exact key screen can be app-gated; official app and docs are the nearest setup targets.",
    "fallback_url": "https://docs.firecrawl.dev/",
    "homepage_url": "https://www.firecrawl.dev/",
    "setup_note": "Supply the Firecrawl API key for scrape, crawl, and map requests. Create or copy an API key in the Firecrawl app; provider plan limits apply.",
    "signup_url": "https://app.firecrawl.dev/",
    "docs": [
      "https://docs.firecrawl.dev/api-reference/v2-introduction",
      "https://docs.firecrawl.dev/api-reference/v2-endpoint/scrape",
      "https://docs.firecrawl.dev/api-reference/v2-endpoint/crawl-post",
      "https://docs.firecrawl.dev/api-reference/v2-endpoint/crawl-get",
      "https://docs.firecrawl.dev/api-reference/v2-endpoint/map",
      "https://docs.firecrawl.dev/api-reference/v2-endpoint/extract",
      "https://docs.firecrawl.dev/api-reference/errors",
      "https://docs.firecrawl.dev/rate-limits"
    ]
  },
  "implementation": "stackos_connectors.connectors.firecrawl.actions:FirecrawlActionConnector",
  "icon": {
    "path": "connectors/firecrawl/assets/icon.png",
    "media_type": "image/png",
    "kind": "icon"
  }
}
