{
  "schema_version": "stackos.connector.v1",
  "connector": "byteplus-seedance",
  "name": "BytePlus ModelArk",
  "description": "BytePlus ModelArk media generation provider.",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Supply API key credentials.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "fields": [
          {
            "description": null,
            "key": "api_key",
            "label": "BytePlus ModelArk API Key",
            "options": null,
            "placeholder": null,
            "required": true,
            "secret": true,
            "type": "secret"
          }
        ],
        "description": "Supply API key credentials."
      }
    }
  ],
  "actions": [
    {
      "key": "byteplus.video.generate",
      "operation": "video.generate",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string"
          },
          "model": {
            "enum": [
              "dreamina-seedance-2-0-260128",
              "dreamina-seedance-2-0-fast-260128",
              "seedance-1-5-pro-251215",
              "seedance-1-0-pro-250528",
              "seedance-1-0-pro-fast-251015"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "text-to-video",
              "image-to-video",
              "first-last-frame",
              "reference-to-video"
            ],
            "type": "string"
          },
          "region": {
            "enum": [
              "ap-southeast-1"
            ],
            "type": "string"
          },
          "resolution": {
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "type": "string"
          },
          "ratio": {
            "enum": [
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16",
              "21:9",
              "adaptive"
            ],
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "description": "-1 for model default on 2.0/1.5 only; model-specific ranges are 2.0: 4-15, 1.5 Pro: 4-12, 1.0: 2-12 seconds."
          },
          "input_image_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Caller-provided local file paths."
          },
          "reference_video_urls": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "type": "array"
          },
          "reference_audio_urls": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "type": "array"
          },
          "generate_audio": {
            "type": "boolean"
          },
          "watermark": {
            "type": "boolean"
          },
          "seed": {
            "maximum": 4294967295,
            "minimum": -1,
            "type": "integer"
          },
          "return_last_frame": {
            "type": "boolean"
          },
          "safety_identifier": {
            "type": "string"
          },
          "priority": {
            "maximum": 9,
            "minimum": 0,
            "type": "integer"
          },
          "poll_interval_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "poll_timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "prompt",
          "model",
          "mode",
          "region",
          "resolution",
          "ratio",
          "duration",
          "poll_interval_seconds",
          "poll_timeout_seconds"
        ]
      },
      "output_schema": {
        "additionalProperties": true,
        "properties": {
          "data": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "file_format": {
                  "enum": [
                    "mp4"
                  ],
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "source_model": {
                  "type": "string"
                },
                "path": {
                  "type": "string",
                  "description": "Path of the output file in the caller-provided output directory."
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "config": {},
      "description": "Generate BytePlus Seedance Video. Supply native inputs and an output directory for downloaded media.",
      "metadata": {
        "name": "Generate BytePlus Seedance Video"
      }
    }
  ],
  "setup": {
    "billing_url": "https://console.byteplus.com/finance/",
    "console_url": "https://console.byteplus.com/",
    "credential_label": "BytePlus ModelArk API key",
    "credential_url": "https://console.byteplus.com/iam/keymanage/",
    "docs_url": "https://docs.byteplus.com/en/docs/ModelArk/",
    "fallback_url": "https://docs.byteplus.com/en/docs/ModelArk/",
    "homepage_url": "https://www.byteplus.com/en/product/modelark",
    "signup_url": "https://console.byteplus.com/",
    "setup_note": "Obtain the provider credentials and supply the resolved execution fields for each call.",
    "docs": [
      "https://docs.byteplus.com/en/docs/ModelArk/1520757",
      "https://docs.byteplus.com/en/docs/ModelArk/1521309",
      "https://docs.byteplus.com/en/docs/ModelArk/1330310",
      "https://docs.byteplus.com/en/docs/ModelArk/1544106",
      "https://docs.byteplus.com/en/docs/ModelArk/1298459"
    ]
  },
  "icon": {
    "path": "shared/icons/integration.svg",
    "media_type": "image/svg+xml",
    "kind": "fallback"
  },
  "implementation": "stackos_connectors.connectors.byteplus_seedance.actions:MediaActionConnector"
}
