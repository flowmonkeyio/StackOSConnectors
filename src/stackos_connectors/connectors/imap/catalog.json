      "setup": {
        "auth_type": "imap-password",
        "description": "Use the mailbox provider's IMAP host, port, TLS mode, username and password or app password.",
        "fields": [
          {
            "key": "password",
            "label": "Password",
            "required": true,
            "secret": true,
            "type": "secret"
          },
          {
            "key": "host",
            "label": "Host",
            "placeholder": "imap.example.com",
            "required": true,
            "secret": false,
            "type": "text"
          },
          {
            "key": "port",
            "label": "Port",
            "placeholder": "993",
            "required": true,
            "secret": false,
            "type": "number"
          },
          {
            "key": "tls_mode",
            "label": "TLS Mode",
            "options": [
              {
                "label": "SSL",
                "value": "ssl"
              },
              {
                "label": "STARTTLS",
                "value": "starttls"
              },
              {
                "label": "None",
                "value": "none"
              }
            ],
            "required": true,
            "secret": false,
            "type": "select"
          },
          {
            "key": "username",
            "label": "Username",
            "required": true,
            "secret": false,
            "type": "text"
          },
          {
            "description": "Optional public CA certificate bundle, added to default roots with hostname and certificate verification retained.",
            "key": "tls_ca_pem",
            "label": "Additional trusted CA certificates (PEM)",
            "placeholder": "-----BEGIN CERTIFICATE-----",
            "required": false,
            "secret": false,
            "type": "textarea"
          }
        ],
        "interactive": false,
        "label": "IMAP password"
      }
    }
