                "file_format": {
                  "enum": [
                    "webp",
                    "png",
                    "jpg",
                    "jpeg"
                  ],
                  "type": "string"
                },
                "source_model": {
                  "type": "string"
                },
                "path": {
                  "type": "string",
                  "description": "Path of the output file in the caller-provided output directory."
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "finish_reason": {
            "type": "string"
          },
          "grounding_metadata": {
            "additionalProperties": false,
            "properties": {
              "groundingChunks": {
                "description": "Provider source positions; invalid slots remain empty objects.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "web": {
                      "additionalProperties": false,
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "uri": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "groundingSupports": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "groundingChunkIndices": {
                      "description": "Indices into the unchanged groundingChunks order.",
                      "items": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    "segment": {
                      "additionalProperties": false,
                      "properties": {
                        "endIndex": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "startIndex": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "segment",
                    "groundingChunkIndices"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "webSearchQueries": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "provider_request_id": {
            "type": "string"
          },
          "requested_model": {
            "type": "string"
          },
          "returned_model": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "usage": {
            "additionalProperties": false,
            "properties": {
              "cached_count": {
                "minimum": 0,
                "type": "integer"
              },
              "completion_count": {
                "minimum": 0,
                "type": "integer"
              },
              "google_searches": {
                "minimum": 0,
                "type": "integer"
              },
              "prompt_count": {
                "minimum": 0,
                "type": "integer"
              },
              "reasoning_count": {
                "minimum": 0,
                "type": "integer"
              },
              "total_count": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "config": {},
      "description": "Generate one JPEG through the AIGNC image model.",
      "metadata": {
        "name": "Generate AIGNC Image"
      }
    },
    {
      "key": "aignc.audio.analyze",
      "operation": "audio.analyze",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "audio_path": {
            "type": "string",
            "minLength": 1,
            "description": "Path to a readable local audio file."
          },
          "instruction": {
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "enum": [
              "gemini-3.8-flash",
              "gemini-3.7-flash"
            ],
            "type": "string"
          },
          "max_tokens": {
            "minimum": 1,
            "type": "integer"
          },
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "mp3",
              "aac",
              "flac",
              "ogg"
            ]
          }
        },
        "required": [
          "model",
          "instruction",
          "max_tokens",
          "audio_path",
          "format"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "properties": {
          "finish_reason": {
            "type": "string"
          },
          "grounding_metadata": {
            "additionalProperties": false,
            "properties": {
              "groundingChunks": {
                "description": "Provider source positions; invalid slots remain empty objects.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "web": {
                      "additionalProperties": false,
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "uri": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "groundingSupports": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "groundingChunkIndices": {
                      "description": "Indices into the unchanged groundingChunks order.",
                      "items": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    "segment": {
                      "additionalProperties": false,
                      "properties": {
                        "endIndex": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "startIndex": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "required": [
                    "segment",
                    "groundingChunkIndices"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "webSearchQueries": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "provider_request_id": {
            "type": "string"
          },
          "requested_model": {
            "type": "string"
          },
          "returned_model": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "usage": {
            "additionalProperties": false,
            "properties": {
              "cached_count": {
                "minimum": 0,
                "type": "integer"
              },
              "completion_count": {
                "minimum": 0,
                "type": "integer"
              },
              "google_searches": {
                "minimum": 0,
                "type": "integer"
              },
              "prompt_count": {
                "minimum": 0,
                "type": "integer"
              },
              "reasoning_count": {
                "minimum": 0,
                "type": "integer"
              },
              "total_count": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "config": {},
      "description": "Analyze a local audio file using the selected AIGNC audio model.",
      "metadata": {
        "name": "Analyze AIGNC Audio"
      }
    }
  ]
