{
  "schema_version": "stackos.connector.v1",
  "connector": "ahrefs",
  "probe_implementation": "stackos_connectors.connectors.ahrefs.integration:AhrefsIntegration",
  "name": "Ahrefs",
  "description": "Organic keyword and backlink research provider; requires eligible API access and API units.",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Supply the Ahrefs API key for bearer authentication.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "description": "API Key",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "description": "Ahrefs API v3 calls consume API units and require eligible Direct API access. Obtain an API key in the Ahrefs app. The limits_and_usage action reads subscription information, including plan and key limits and remaining units.",
        "fields": [
          {
            "description": null,
            "key": "api_key",
            "label": "API Key",
            "options": null,
            "placeholder": null,
            "required": true,
            "secret": true,
            "type": "secret"
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "key": "competitor.keywords",
      "operation": "competitor.keywords",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "limit": {
            "description": "Positive number of rows requested from Ahrefs. Defaults to 100; provider plan restrictions are returned by Ahrefs.",
            "minimum": 1,
            "type": "integer"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "description": "Fetch organic keywords for a target. Returns provider data and API-unit response headers. Does not make an implicit limits request.",
      "metadata": {
        "capability": "seo-research",
        "name": "Competitor Keywords",
        "risk_level": "cost"
      }
    },
    {
      "key": "backlink.research",
      "operation": "backlink.research",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "Positive number of rows requested from Ahrefs. Defaults to 100; provider plan restrictions are returned by Ahrefs.",
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "enum": [
              "exact",
              "prefix",
              "domain",
              "subdomains"
            ],
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "description": "Fetch backlinks for a target. Returns provider data and API-unit response headers. Does not make an implicit limits request.",
      "metadata": {
        "capability": "seo-research",
        "name": "Backlink Research",
        "risk_level": "cost"
      }
    },
    {
      "key": "limits_and_usage",
      "operation": "limits_and_usage",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "auth_methods": [
        "api_key"
      ],
      "config": {},
      "description": "Fetch subscription limits and usage with GET /v3/subscription-info/limits-and-usage. Returns provider facts without enforcing caller admission policy.",
      "metadata": {
        "name": "Limits and usage",
        "risk_level": "read"
      }
    }
  ],
  "setup": {
    "billing_url": "https://app.ahrefs.com/account/subscription",
    "console_url": "https://app.ahrefs.com/",
    "credential_label": "Ahrefs API key",
    "credential_url": "https://app.ahrefs.com/api",
    "docs_url": "https://docs.ahrefs.com/",
    "fallback_reason": "API access is plan/account gated; official API docs and Ahrefs app are the nearest setup path.",
    "fallback_url": "https://docs.ahrefs.com/",
    "homepage_url": "https://ahrefs.com/",
    "setup_note": "Ahrefs API v3 calls consume API units and require eligible Direct API access. Obtain an API key in the Ahrefs app. The limits_and_usage action reads subscription information, including plan and key limits and remaining units.",
    "signup_url": "https://app.ahrefs.com/user/sign-up",
    "docs": [
      "https://docs.ahrefs.com/en/api/docs/introduction",
      "https://docs.ahrefs.com/en/api/docs/api-keys-creation-and-management",
      "https://docs.ahrefs.com/en/api/docs/limits-consumption",
      "https://docs.ahrefs.com/en/api/reference/subscription-info/get-limits-and-usage",
      "https://docs.ahrefs.com/en/api/reference/site-explorer",
      "https://docs.ahrefs.com/en/api/reference/site-explorer/get-organic-keywords",
      "https://docs.ahrefs.com/en/api/reference/site-explorer/get-all-backlinks"
    ]
  },
  "implementation": "stackos_connectors.connectors.ahrefs.actions:AhrefsActionConnector",
  "icon": {
    "media_type": "image/png",
    "kind": "icon",
    "path": "connectors/ahrefs/assets/icon.png"
  }
}
