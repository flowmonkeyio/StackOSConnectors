{
  "schema_version": "stackos.connector.v1",
  "connector": "elevenlabs",
  "name": "ElevenLabs",
  "description": "Discover subscription usage, models and voices, search and add shared voices, design voice previews and create voices, generate timestamped speech, and align audio.",
  "icon": {
    "path": "shared/icons/integration.svg",
    "media_type": "image/svg+xml",
    "kind": "fallback"
  },
  "implementation": "stackos_connectors.connectors.elevenlabs.actions:ElevenLabsActionConnector",
  "probe_implementation": "stackos_connectors.connectors.elevenlabs.integration:ElevenLabsIntegration",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Send the resolved ElevenLabs API key in the xi-api-key header.",
      "fields_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\s"
            }
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "description": "Supply a resolved ElevenLabs API key with access to the desired endpoints. The credential probe requires permission to read the subscription.",
        "fields": [
          {
            "key": "api_key",
            "label": "ElevenLabs API key",
            "type": "secret",
            "required": true,
            "secret": true
          }
        ]
      }
    }
  ],
  "setup": {
    "homepage_url": "https://elevenlabs.io/",
    "docs_url": "https://elevenlabs.io/docs/api-reference/authentication",
    "credential_label": "ElevenLabs API key",
    "setup_note": "Supply a resolved ElevenLabs API key with access to the desired endpoints. The credential probe requires permission to read the subscription."
  },
  "actions": [
    {
      "key": "elevenlabs.subscription.get",
      "operation": "subscription.get",
      "description": "Read the subscription tier, current character usage and character allowance.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "string"
          },
          "character_count": {
            "type": "integer"
          },
          "character_limit": {
            "type": "integer"
          }
        },
        "required": [
          "tier",
          "character_count",
          "character_limit"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Get ElevenLabs subscription",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.models.list",
      "operation": "models.list",
      "description": "Return provider models, including non-text-to-speech models, with the capabilities and limits the provider supplies.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "can_do_text_to_speech": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "can_use_style": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "can_use_speaker_boost": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "languages": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "language_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "maximum_text_length_per_request": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "model_id"
              ]
            }
          }
        },
        "required": [
          "models"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "List ElevenLabs models",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.voices.list",
      "operation": "voices.list",
      "description": "Read one page of voices available to the user.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Requested page size. The first page can contain additional default voices."
          },
          "page_token": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Opaque next_page_token returned by the previous page."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "voice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "voice_id"
              ]
            }
          },
          "page_size": {
            "type": "integer"
          },
          "page_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "voices",
          "page_size",
          "page_token",
          "has_more",
          "next_page_token"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "List ElevenLabs voices",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.voices.settings.default.get",
      "operation": "voices.settings.default.get",
      "description": "Read the provider's default voice settings.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stability": {
            "type": [
              "number",
              "null"
            ],
            "description": "Voice consistency on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "similarity_boost": {
            "type": [
              "number",
              "null"
            ],
            "description": "Similarity to the source voice on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "type": [
              "number",
              "null"
            ],
            "description": "Style exaggeration, when supported by the model."
          },
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "description": "Speech speed multiplier, when supported. The documented control range is 0.7–1.2."
          },
          "use_speaker_boost": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Speaker similarity boost, when supported by the model."
          },
          "clone_strength": {
            "type": [
              "number",
              "null"
            ],
            "description": "Applies to professional voice clones fine-tuned for the selected v4 model.",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Get default ElevenLabs voice settings",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.voices.settings.get",
      "operation": "voices.settings.get",
      "description": "Read provider settings saved for the supplied voice.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        },
        "required": [
          "voice_id"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stability": {
            "type": [
              "number",
              "null"
            ],
            "description": "Voice consistency on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "similarity_boost": {
            "type": [
              "number",
              "null"
            ],
            "description": "Similarity to the source voice on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "type": [
              "number",
              "null"
            ],
            "description": "Style exaggeration, when supported by the model."
          },
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "description": "Speech speed multiplier, when supported. The documented control range is 0.7–1.2."
          },
          "use_speaker_boost": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Speaker similarity boost, when supported by the model."
          },
          "clone_strength": {
            "type": [
              "number",
              "null"
            ],
            "description": "Applies to professional voice clones fine-tuned for the selected v4 model.",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Get saved ElevenLabs voice settings",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.library.search",
      "operation": "library.search",
      "description": "Search one page of the ElevenLabs Voice Library and return voice identities and any supplied preview and pricing metadata.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "search": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Zero-based page index."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "has_more": {
            "type": "boolean",
            "description": "Whether the provider has another page."
          },
          "voices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "public_owner_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Public library owner ID."
                },
                "voice_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Shared voice ID."
                },
                "name": {
                  "type": "string"
                },
                "preview_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notice_period": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "rate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Provider credit rate multiplier."
                },
                "fiat_rate": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Provider price in USD per 1,000 credits. Explicit null indicates default pricing."
                }
              },
              "required": [
                "public_owner_id",
                "voice_id",
                "name"
              ]
            }
          }
        },
        "required": [
          "has_more",
          "voices"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Search ElevenLabs Voice Library",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.library.add",
      "operation": "library.add",
      "description": "Add the explicitly identified shared voice to the authenticated ElevenLabs user's collection.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "public_owner_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            },
            "description": "Public library owner ID for the provider's public_user_id path segment."
          },
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            },
            "description": "Shared voice ID to add."
          },
          "new_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Name for the voice in the user's collection."
          }
        },
        "required": [
          "public_owner_id",
          "voice_id",
          "new_name"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "description": "Voice ID returned by ElevenLabs for the added voice."
          }
        },
        "required": [
          "voice_id"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Add shared ElevenLabs voice",
        "read_only": false,
        "risk_level": "write"
      }
    },
    {
      "key": "elevenlabs.voices.design",
      "operation": "voices.design",
      "description": "Generate voice previews once and save each playable preview in the caller's output directory.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000,
            "pattern": "\\S",
            "description": "Describe the voice to generate."
          },
          "text": {
            "type": ["string", "null"],
            "minLength": 100,
            "maxLength": 1000,
            "pattern": "\\S",
            "description": "Explicit preview script. Supply a script or set auto_generate_text to true."
          },
          "auto_generate_text": {
            "type": "boolean",
            "description": "Let ElevenLabs generate the preview script."
          },
          "model_id": {
            "enum": ["eleven_multilingual_ttv_v2", "eleven_ttv_v3"],
            "default": "eleven_multilingual_ttv_v2",
            "description": "Voice design model."
          },
          "loudness": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "seed": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 2147483647
          },
          "guidance_scale": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "should_enhance": {
            "type": "boolean",
            "description": "Let ElevenLabs enhance the voice description."
          },
          "quality": {
            "type": ["number", "null"],
            "minimum": -1,
            "maximum": 1
          },
          "reference_audio_base64": {
            "type": ["string", "null"],
            "minLength": 1,
            "description": "Base64-encoded reference audio for eleven_ttv_v3."
          },
          "prompt_strength": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1,
            "description": "Balance between the description and reference audio for eleven_ttv_v3."
          },
          "stream_previews": {
            "type": "boolean",
            "const": false,
            "description": "The action saves previews from the non-streaming response."
          },
          "output_format": {
            "type": "string",
            "enum": [
              "alaw_8000",
              "mp3_22050_32",
              "mp3_24000_48",
              "mp3_44100_128",
              "mp3_44100_192",
              "mp3_44100_32",
              "mp3_44100_64",
              "mp3_44100_96",
              "opus_48000_128",
              "opus_48000_192",
              "opus_48000_32",
              "opus_48000_64",
              "opus_48000_96",
              "pcm_16000",
              "pcm_22050",
              "pcm_24000",
              "pcm_32000",
              "pcm_44100",
              "pcm_48000",
              "pcm_8000",
              "ulaw_8000"
            ],
            "description": "Optional provider output format. Saved files use the MIME type returned for each preview."
          }
        },
        "required": ["voice_description"],
        "oneOf": [
          {"required": ["text"], "properties": {"text": {"type": "string"}}},
          {"required": ["auto_generate_text"], "properties": {"auto_generate_text": {"const": true}}}
        ],
        "if": {
          "required": ["model_id"],
          "properties": {"model_id": {"const": "eleven_ttv_v3"}}
        },
        "else": {
          "properties": {
            "reference_audio_base64": {"type": "null"},
            "prompt_strength": {"type": "null"}
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": ["success", "partial", "failed"],
            "description": "All, some, or none of the returned previews were saved."
          },
          "text": {
            "type": "string",
            "description": "Preview script returned by ElevenLabs."
          },
          "previews": {
            "type": "array",
            "minItems": 1,
            "description": "One row per provider preview, in provider order.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "generated_voice_id": {"type": "string", "minLength": 1},
                "duration_secs": {"type": "number", "minimum": 0},
                "media_type": {"type": "string"},
                "language": {"type": ["string", "null"]},
                "file_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based index of this preview's descriptor in result.files."
                },
                "reason_code": {
                  "enum": ["invalid_preview", "audio_persistence_failed"],
                  "description": "Why this preview has no saved file."
                }
              },
              "oneOf": [
                {
                  "required": ["generated_voice_id", "duration_secs", "media_type", "file_index"],
                  "not": {"required": ["reason_code"]}
                },
                {
                  "required": ["reason_code"],
                  "not": {"required": ["file_index"]}
                }
              ]
            }
          }
        },
        "required": ["status", "previews"]
      },
      "auth_methods": ["api_key"],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Design ElevenLabs voice previews",
        "read_only": false,
        "risk_level": "cost"
      }
    },
    {
      "key": "elevenlabs.voices.create",
      "operation": "voices.create",
      "description": "Create a permanent ElevenLabs voice from the generated voice ID the caller selected.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "generated_voice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Caller-selected generated voice ID."
          },
          "voice_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "voice_description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        },
        "required": ["generated_voice_id", "voice_name", "voice_description"]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "description": "Permanent voice ID returned by ElevenLabs."
          }
        },
        "required": ["voice_id"]
      },
      "auth_methods": ["api_key"],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Create ElevenLabs voice",
        "read_only": false,
        "risk_level": "write"
      }
    },
    {
      "key": "elevenlabs.speech.generate",
      "operation": "speech.generate",
      "description": "Generate timestamped speech once and save the audio in the caller's output directory.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "voice_settings": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "stability": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "similarity_boost": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "style": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "speed": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0.7,
                "maximum": 1.2
              },
              "use_speaker_boost": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "clone_strength": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "previous_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4294967295
          },
          "pronunciation_dictionary_locators": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pronunciation_dictionary_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "version_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S",
                  "description": "Omit or pass null to use the provider's latest version."
                }
              },
              "required": [
                "pronunciation_dictionary_id"
              ]
            },
            "maxItems": 3,
            "description": "Dictionaries are applied in the supplied order."
          },
          "output_format": {
            "type": "string",
            "enum": [
              "alaw_8000",
              "mp3_22050_32",
              "mp3_24000_48",
              "mp3_44100_128",
