{
  "schema_version": "stackos.connector.v1",
  "connector": "elevenlabs",
  "name": "ElevenLabs",
  "description": "Discover subscription usage, models and voices, generate timestamped speech, and align audio.",
  "icon": {
    "path": "shared/icons/integration.svg",
    "media_type": "image/svg+xml",
    "kind": "fallback"
  },
  "implementation": "stackos_connectors.connectors.elevenlabs.actions:ElevenLabsActionConnector",
  "probe_implementation": "stackos_connectors.connectors.elevenlabs.integration:ElevenLabsIntegration",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Send the resolved ElevenLabs API key in the xi-api-key header.",
      "fields_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\s"
            }
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "description": "Supply a resolved ElevenLabs API key with access to the desired endpoints. The credential probe requires permission to read the subscription.",
        "fields": [
          {
            "key": "api_key",
            "label": "ElevenLabs API key",
            "type": "secret",
            "required": true,
            "secret": true
          }
        ]
      }
    }
  ],
  "setup": {
    "homepage_url": "https://elevenlabs.io/",
    "docs_url": "https://elevenlabs.io/docs/api-reference/authentication",
    "credential_label": "ElevenLabs API key",
    "setup_note": "Supply a resolved ElevenLabs API key with access to the desired endpoints. The credential probe requires permission to read the subscription."
  },
  "actions": [
    {
      "key": "elevenlabs.subscription.get",
      "operation": "subscription.get",
      "description": "Read the subscription tier, current character usage and character allowance.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "string"
          },
          "character_count": {
            "type": "integer"
          },
          "character_limit": {
            "type": "integer"
          }
        },
        "required": [
          "tier",
          "character_count",
          "character_limit"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Get ElevenLabs subscription",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.models.list",
      "operation": "models.list",
      "description": "Return provider models, including non-text-to-speech models, with the capabilities and limits the provider supplies.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "can_do_text_to_speech": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "can_use_style": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "can_use_speaker_boost": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "languages": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "language_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "maximum_text_length_per_request": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "model_id"
              ]
            }
          }
        },
        "required": [
          "models"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "List ElevenLabs models",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.voices.list",
      "operation": "voices.list",
      "description": "Read one page of voices available to the user.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Requested page size. The first page can contain additional default voices."
          },
          "page_token": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Opaque next_page_token returned by the previous page."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "voice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "voice_id"
              ]
            }
          },
          "page_size": {
            "type": "integer"
          },
          "page_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "next_page_token": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "voices",
          "page_size",
          "page_token",
          "has_more",
          "next_page_token"
        ]
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "List ElevenLabs voices",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.voices.settings.default.get",
      "operation": "voices.settings.default.get",
      "description": "Read the provider's default voice settings.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stability": {
            "type": [
              "number",
              "null"
            ],
            "description": "Voice consistency on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "similarity_boost": {
            "type": [
              "number",
              "null"
            ],
            "description": "Similarity to the source voice on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "type": [
              "number",
              "null"
            ],
            "description": "Style exaggeration, when supported by the model."
          },
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "description": "Speech speed multiplier, when supported. The documented control range is 0.7–1.2."
          },
          "use_speaker_boost": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Speaker similarity boost, when supported by the model."
          },
          "clone_strength": {
            "type": [
              "number",
              "null"
            ],
            "description": "Applies to professional voice clones fine-tuned for the selected v4 model.",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Get default ElevenLabs voice settings",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.voices.settings.get",
      "operation": "voices.settings.get",
      "description": "Read provider settings saved for the supplied voice.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        },
        "required": [
          "voice_id"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stability": {
            "type": [
              "number",
              "null"
            ],
            "description": "Voice consistency on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "similarity_boost": {
            "type": [
              "number",
              "null"
            ],
            "description": "Similarity to the source voice on a 0–1 scale.",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "type": [
              "number",
              "null"
            ],
            "description": "Style exaggeration, when supported by the model."
          },
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "description": "Speech speed multiplier, when supported. The documented control range is 0.7–1.2."
          },
          "use_speaker_boost": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Speaker similarity boost, when supported by the model."
          },
          "clone_strength": {
            "type": [
              "number",
              "null"
            ],
            "description": "Applies to professional voice clones fine-tuned for the selected v4 model.",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Get saved ElevenLabs voice settings",
        "read_only": true,
        "risk_level": "read"
      }
    },
    {
      "key": "elevenlabs.speech.generate",
      "operation": "speech.generate",
      "description": "Generate timestamped speech once and save the audio in the caller's output directory.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "voice_settings": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "stability": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "similarity_boost": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "style": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "speed": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0.7,
                "maximum": 1.2
              },
              "use_speaker_boost": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "clone_strength": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "previous_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4294967295
          },
          "pronunciation_dictionary_locators": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pronunciation_dictionary_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "version_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S",
                  "description": "Omit or pass null to use the provider's latest version."
                }
              },
              "required": [
                "pronunciation_dictionary_id"
              ]
            },
            "maxItems": 3,
            "description": "Dictionaries are applied in the supplied order."
          },
          "output_format": {
            "type": "string",
            "enum": [
              "alaw_8000",
              "mp3_22050_32",
              "mp3_24000_48",
              "mp3_44100_128",
              "mp3_44100_192",
              "mp3_44100_32",
              "mp3_44100_64",
              "mp3_44100_96",
              "opus_48000_128",
              "opus_48000_192",
              "opus_48000_32",
              "opus_48000_64",
              "opus_48000_96",
              "pcm_16000",
              "pcm_22050",
              "pcm_24000",
              "pcm_32000",
              "pcm_44100",
              "pcm_48000",
              "pcm_8000",
              "ulaw_8000",
              "wav_16000",
              "wav_22050",
              "wav_24000",
              "wav_32000",
              "wav_44100",
              "wav_48000",
              "wav_8000"
            ],
            "default": "mp3_44100_128"
          }
        },
        "required": [
          "voice_id",
          "text"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "output_format": {
            "type": "string",
            "enum": [
              "alaw_8000",
              "mp3_22050_32",
              "mp3_24000_48",
              "mp3_44100_128",
              "mp3_44100_192",
              "mp3_44100_32",
              "mp3_44100_64",
              "mp3_44100_96",
              "opus_48000_128",
              "opus_48000_192",
              "opus_48000_32",
              "opus_48000_64",
              "opus_48000_96",
              "pcm_16000",
              "pcm_22050",
              "pcm_24000",
              "pcm_32000",
              "pcm_44100",
              "pcm_48000",
              "pcm_8000",
              "ulaw_8000",
              "wav_16000",
              "wav_22050",
              "wav_24000",
              "wav_32000",
              "wav_44100",
              "wav_48000",
              "wav_8000"
            ]
          },
          "alignment": {
            "$ref": "#/$defs/character_alignment"
          },
          "normalized_alignment": {
            "$ref": "#/$defs/character_alignment"
          }
        },
        "required": [
          "output_format"
        ],
        "$defs": {
          "character_alignment": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "properties": {
              "characters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "character_start_times_seconds": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "character_end_times_seconds": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "characters",
              "character_start_times_seconds",
              "character_end_times_seconds"
            ]
          }
        }
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Generate ElevenLabs speech with timestamps",
        "read_only": false,
        "risk_level": "cost"
      }
    },
    {
      "key": "elevenlabs.alignment.create",
      "operation": "alignment.create",
      "description": "Upload a caller-supplied local audio file and align it to the supplied transcript.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "audio_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Path to a readable local audio file under 1 GB."
          },
          "mime_type": {
            "type": "string",
            "pattern": "^[aA][uU][dD][iI][oO]/[A-Za-z0-9][A-Za-z0-9.+_-]*$",
            "not": {
              "pattern": "\\s"
            },
            "maxLength": 127,
            "description": "Audio media type used in the file part, for example audio/wav."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Transcript to align to the audio."
          }
        },
        "required": [
          "audio_path",
          "mime_type",
          "text"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/timed_item"
            }
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/timed_item"
            }
          },
          "loss": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "words"
        ],
        "$defs": {
          "timed_item": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "description": "Start time in seconds."
              },
              "end": {
                "type": "number",
                "description": "End time in seconds."
              },
              "loss": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "text",
              "start",
              "end"
            ]
          }
        }
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": false,
      "config": {},
      "metadata": {
        "name": "Align audio with a transcript using ElevenLabs",
        "read_only": false,
        "risk_level": "cost"
      }
    }
  ]
}
