{
  "schema_version": "stackos.connector.v1",
  "connector": "sitemap",
  "name": "Sitemap",
  "description": "Read public XML sitemaps and sitemap indexes to discover page URLs.",
  "auth_methods": [],
  "actions": [
    {
      "key": "sitemap.fetch",
      "operation": "fetch",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "max_entries": {
            "maximum": 20000,
            "minimum": 1,
            "type": "integer"
          },
          "max_index_depth": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "timeout_s": {
            "maximum": 60,
            "minimum": 0.1,
            "type": "number"
          },
          "urls": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "urls"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [],
      "auth_optional": false,
      "config": {},
      "description": "Fetch and parse public sitemap URLs with sitemap-index recursion.",
      "metadata": {
        "capability": "web-retrieval",
        "name": "Fetch Sitemap",
        "risk_level": "read"
      }
    }
  ],
  "setup": {
    "setup_note": "Supply a public sitemap URL. Authentication is not required. The sitemap protocol permits up to 50 MB uncompressed and 50,000 URLs per sitemap; caller-selected byte and entry limits may be lower.",
    "docs": [
      "https://www.sitemaps.org/protocol.html",
      "https://www.sitemaps.org/faq.html",
      "https://developers.google.com/search/reference/robots_txt"
    ]
  },
  "implementation": "stackos_connectors.connectors.sitemap.actions:SitemapActionConnector",
  "icon": {
    "path": "shared/icons/integration.svg",
    "media_type": "image/svg+xml",
    "kind": "fallback"
  }
}
