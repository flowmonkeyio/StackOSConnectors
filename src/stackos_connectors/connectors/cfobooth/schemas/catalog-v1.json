{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operations": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9.]{2,119}$"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 10,
                "maxLength": 2000
              },
              "route": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "PATCH",
                      "PUT",
                      "DELETE"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/api(?:/(?:[A-Za-z0-9][A-Za-z0-9._~-]*|:[A-Za-z][A-Za-z0-9]*))*$",
                    "maxLength": 2048
                  },
                  "body": {
                    "type": "string",
                    "enum": [
                      "none",
                      "json",
                      "multipart"
                    ]
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 299
                  }
                },
                "required": [
                  "method",
                  "path",
                  "body",
                  "status"
                ],
                "additionalProperties": false
              },
              "authentication": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "public"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "authenticated"
                      },
                      "credentials": {
                        "minItems": 1,
                        "maxItems": 2,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "session",
                            "api-key"
                          ]
                        }
                      },
                      "organizationParameter": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "organizationId"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "credentials",
                      "organizationParameter"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "public",
                  "account",
                  "organization"
                ]
              },
              "transport": {
                "type": "string",
                "enum": [
                  "json",
                  "sse",
                  "multipart",
                  "binary",
                  "browser-session"
                ]
              },
              "effect": {
                "type": "string",
                "enum": [
                  "read",
                  "mutation"
                ]
              },
              "replay": {
                "type": "string",
                "enum": [
                  "safe",
                  "explicit-only"
                ]
              },
              "execution": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "action"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "excluded"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "kind",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "responseLimit": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 16777216
              },
              "schemaValidation": {
                "type": "string",
                "const": "server"
              },
              "schemas": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/definitions/__schema0"
                    }
                  },
                  "query": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/definitions/__schema0"
                    }
                  },
                  "body": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/definitions/__schema0"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "result": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/definitions/__schema0"
                    }
                  },
                  "error": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "#/definitions/__schema0"
                    }
                  }
                },
                "required": [
                  "params",
                  "query",
                  "body",
                  "result",
                  "error"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "operationId",
              "title",
              "description",
              "route",
              "authentication",
              "scope",
              "transport",
              "effect",
              "replay",
              "execution",
              "responseLimit",
              "schemaValidation",
              "schemas"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "catalogHash",
        "operations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "data"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema0"
          }
        }
      ]
    }
  }
}
