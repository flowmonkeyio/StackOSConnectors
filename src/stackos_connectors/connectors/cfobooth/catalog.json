{
  "schema_version": "stackos.connector.v1",
  "connector": "cfobooth",
  "name": "CFOBooth",
  "description": "Connect to a CFOBooth API using its server URL and an API key.",
  "implementation": "stackos_connectors.connectors.cfobooth.actions:CFOBoothActionConnector",
  "probe_implementation": "stackos_connectors.connectors.cfobooth.probe:probe",
  "icon": {
    "kind": "fallback",
    "media_type": "image/svg+xml",
    "path": "shared/icons/integration.svg"
  },
  "auth_methods": [
    {
      "key": "api_key",
      "fields_schema": {
        "type": "object",
        "required": [
          "api_key"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "config_schema": {
        "type": "object",
        "required": [
          "api_base_url"
        ],
        "properties": {
          "api_base_url": {
            "type": "string",
            "minLength": 1
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "payload_format": "json",
      "evidence_source": "provider_probe",
      "description": "CFOBooth API key with an explicit endpoint. Catalog and actions require the verified organization binding supplied by the host.",
      "setup": {
        "auth_type": "api_key",
        "interactive": false,
        "description": "Enter your CFOBooth server URL and API key to verify the key and discover its organization.",
        "fields": [
          {
            "key": "api_key",
            "label": "API key",
            "secret": true,
            "required": true,
            "type": "password"
          },
          {
            "key": "api_base_url",
            "label": "API base URL",
            "required": true,
            "placeholder": "https://cfobooth.com",
            "description": "Editable example only. Use your owned local HTTP loopback or remote HTTPS endpoint.",
            "type": "text",
            "secret": false
          }
        ],
        "label": "CFOBooth API key"
      }
    }
  ],
  "actions": [
    {
      "key": "cfobooth.catalog.export",
      "operation": "catalog.export",
      "description": "Fetch and validate the complete permission-filtered organization operation catalog.",
      "guidance": "Use Account credentials and the host's verified organization binding. Register eligible fixed routes explicitly; no catalog preflight occurs during operation execution.",
      "auth_methods": [
        "api_key"
      ],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      },
      "config": {},
      "metadata": {
        "name": "Export CFOBooth Catalog",
        "read_only": true,
        "risk_level": "read"
      }
    }
  ],
  "auth_type": "api_key"
}
