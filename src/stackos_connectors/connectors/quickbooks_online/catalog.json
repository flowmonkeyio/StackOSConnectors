{
  "schema_version": "stackos.connector.v1",
  "connector": "quickbooks-online",
  "name": "QuickBooks Online",
  "description": "Bounded company and invoice reads with explicit caller-owned OAuth.",
  "auth_type": "oauth",
  "probe_implementation": "stackos_connectors.connectors.quickbooks_online.probe:probe",
  "auth_methods": [
    {
      "key": "oauth2_authorization_code",
      "description": "Caller-supplied resolved OAuth bearer token; grants are always explicit.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s]+$"
          }
        },
        "required": [
          "access_token"
        ],
        "additionalProperties": false
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ]
          },
          "realm_id": {
            "type": "string",
            "pattern": "^[0-9]{1,32}$"
          }
        },
        "required": [
          "environment",
          "realm_id"
        ],
        "additionalProperties": false
      },
      "setup": {
        "label": "Connect with QuickBooks",
        "auth_type": "oauth",
        "interactive": true,
        "description": "Register an Intuit app, verify callback state and realmId, and supply its resolved accounting access token.",
        "fields": [
          {
            "key": "client_id",
            "label": "Client Id",
            "type": "secret",
            "secret": true,
            "required": true
          },
          {
            "key": "client_secret",
            "label": "Client Secret",
            "type": "secret",
            "secret": true,
            "required": true
          },
          {
            "key": "environment",
            "label": "Environment",
            "type": "select",
            "secret": false,
            "required": true,
            "options": [
              {"value": "sandbox", "label": "Sandbox"},
              {"value": "production", "label": "Production"}
            ],
            "description": "Choose the intended QuickBooks environment explicitly; there is no default."
          },
          {
            "key": "realm_id",
            "label": "Company realm ID",
            "type": "text",
            "secret": false,
            "required": true,
            "description": "Numeric company realm ID, 1–32 digits. Bind it to the intended company and verify callback realmId before token exchange."
          }
        ]
      },
      "evidence_source": "oauth_response",
      "protocol": {
        "grant_types": [
          "authorization_code",
          "refresh_token"
        ]
      }
    },
    {
      "key": "oauth2_token",
      "description": "Caller-supplied resolved OAuth bearer token; grants are always explicit.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s]+$"
          }
        },
        "required": [
          "access_token"
        ],
        "additionalProperties": false
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ]
          },
          "realm_id": {
            "type": "string",
            "pattern": "^[0-9]{1,32}$"
          }
        },
        "required": [
          "environment",
          "realm_id"
        ],
        "additionalProperties": false
      },
      "setup": {
        "label": "OAuth2 access token",
        "auth_type": "oauth",
        "interactive": false,
        "description": "Register an Intuit app, verify callback state and realmId, and supply its resolved accounting access token.",
        "fields": [
          {
            "key": "access_token",
            "label": "Access Token",
            "type": "secret",
            "secret": true,
            "required": true
          },
          {
            "key": "environment",
            "label": "Environment",
            "type": "select",
            "secret": false,
            "required": true,
            "options": [
              {"value": "sandbox", "label": "Sandbox"},
              {"value": "production", "label": "Production"}
            ],
            "description": "Choose the intended QuickBooks environment explicitly; there is no default."
          },
          {
            "key": "realm_id",
            "label": "Company realm ID",
            "type": "text",
            "secret": false,
            "required": true,
            "description": "Numeric company realm ID, 1–32 digits. Supply the company realm bound to this access token."
          }
        ]
      },
      "evidence_source": "unavailable",
      "protocol": {
        "grant_types": [
          "refresh_token"
        ]
      }
    }
  ],
  "auth_protocol": {
    "flow": "authorization_code",
    "authorization_endpoint": "https://appcenter.intuit.com/connect/oauth2",
    "token_endpoint": "https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer",
    "client_auth_style": "basic",
    "pkce_mode": "unavailable",
    "scopes": [
      "com.intuit.quickbooks.accounting"
    ],
    "response_account_id_field": null
  },
  "actions": [
    {
      "key": "quickbooks-online.company-info.get",
      "operation": "company-info.get",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "realm_id": {
            "type": "string",
            "minLength": 1
          },
          "company_id": {
            "type": "string",
            "minLength": 1
          },
          "company_name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "realm_id",
          "company_id"
        ],
        "additionalProperties": false
      },
      "auth_methods": [
        "oauth2_authorization_code",
        "oauth2_token"
      ],
      "description": "Read CompanyInfo for the configured realm. Returned realm_id repeats request context, not independent provider attestation.",
      "guidance": "Caller owns pagination, complete-scan limits and current-state semantics. total_count is supplied metadata only; missing currency remains unknown. See provider docs.",
      "metadata": {
        "name": "Read company info",
        "risk_level": "read"
      },
      "config": {}
    },
    {
      "key": "quickbooks-online.invoices.list",
      "operation": "invoices.list",
      "input_schema": {
        "type": "object",
        "properties": {
          "txn_date_from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "txn_date_to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "start_position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "txn_date_from",
          "txn_date_to",
          "start_position",
          "max_results"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "invoices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "native_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_json": {
                  "type": "string",
                  "minLength": 1
                },
                "source_revision": {
                  "type": "string",
                  "minLength": 1
                },
                "source_updated_at": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "native_id",
                "raw_json"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "start_position": {
            "type": "integer",
            "minimum": 1
          },
          "max_results": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "invoices",
          "start_position",
          "max_results",
          "count"
        ],
        "additionalProperties": false
      },
      "auth_methods": [
        "oauth2_authorization_code",
        "oauth2_token"
      ],
      "description": "Read one bounded Invoice page by inclusive TxnDate, retaining exact JSON source fragments without floating-point conversion.",
      "guidance": "Caller owns pagination, complete-scan limits and current-state semantics. total_count is supplied metadata only; missing currency remains unknown. See provider docs.",
      "metadata": {
        "name": "Read invoice page",
        "risk_level": "read"
      },
      "config": {}
    }
  ],
  "implementation": "stackos_connectors.connectors.quickbooks_online.actions:QuickBooksActionConnector",
  "icon": {
    "path": "shared/icons/integration.svg",
    "kind": "icon",
    "media_type": "image/svg+xml"
  },
  "setup": {
    "homepage_url": "https://developer.intuit.com/",
    "docs_url": "https://developer.intuit.com/app/developer/qbo/docs/api/accounting/most-commonly-used/invoice",
    "docs": [
      "connectors/quickbooks_online/docs/quickbooks-online.md",
      "connectors/quickbooks_online/docs/auth.md"
    ],
    "setup_note": "The caller stores tokens and binds environment plus realm_id after verified OAuth callback state. No implicit authorization or refresh."
  }
}
