{
  "schema_version": "stackos.connector.v1",
  "connector": "jina",
  "probe_implementation": "stackos_connectors.connectors.jina.integration:JinaReaderIntegration",
  "name": "Jina Reader",
  "description": "Readable web document extraction provider; API key is optional for higher quota.",
  "auth_methods": [
    {
      "key": "api_key",
      "description": "Supply the optional Jina Reader API key for authenticated requests.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "description": "API Key",
            "type": "string"
          }
        },
        "required": [
          "api_key"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "payload_format": "raw",
      "payload_field": "api_key",
      "setup": {
        "label": "API key",
        "fields": [
          {
            "description": null,
            "key": "api_key",
            "label": "API Key",
            "options": null,
            "placeholder": null,
            "required": false,
            "secret": true,
            "type": "secret"
          }
        ],
        "description": "The API key is optional; anonymous requests are supported. Jina Reader can run without a key. An API key from the Jina dashboard provides authenticated access with provider quota limits."
      }
    }
  ],
  "actions": [
    {
      "key": "web.read",
      "operation": "read",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "type": "object"
      },
      "auth_methods": [
        "api_key"
      ],
      "auth_optional": true,
      "config": {},
      "description": "Fetch a readable Markdown view of a URL through Jina Reader.",
      "metadata": {
        "capability": "web-retrieval",
        "name": "Read Web Page",
        "risk_level": "read"
      }
    }
  ],
  "setup": {
    "billing_url": "https://jina.ai/pricing",
    "console_url": "https://jina.ai/api-dashboard/",
    "credential_label": "Optional Jina API key",
    "credential_url": "https://jina.ai/api-dashboard/",
    "docs_url": "https://docs.jina.ai/",
    "fallback_reason": "Exact dashboard routing can vary; use the official Jina API dashboard.",
    "fallback_url": "https://jina.ai/api-dashboard/",
    "homepage_url": "https://jina.ai/",
    "setup_note": "The API key is optional; anonymous requests are supported. Jina Reader can run without a key. An API key from the Jina dashboard provides authenticated access with provider quota limits.",
    "signup_url": "https://jina.ai/",
    "docs": [
      "https://jina.ai/en-US/reader/",
      "https://github.com/jina-ai/reader"
    ]
  },
  "implementation": "stackos_connectors.connectors.jina.actions:JinaActionConnector",
  "icon": {
    "path": "connectors/jina/assets/icon.png",
    "media_type": "image/png",
    "kind": "icon"
  }
}
