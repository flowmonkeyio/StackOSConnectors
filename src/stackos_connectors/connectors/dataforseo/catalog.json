{
  "schema_version": "stackos.connector.v1",
  "connector": "dataforseo",
  "probe_implementation": "stackos_connectors.connectors.dataforseo.probe:Integration",
  "name": "DataForSEO",
  "description": "SERP, keyword volume, and competitor research provider.",
  "auth_methods": [
    {
      "key": "basic",
      "description": "Supply the API password in fields and API login in config for HTTP Basic authentication.",
      "fields_schema": {
        "type": "object",
        "properties": {
          "password": {
            "description": "API Password",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "password"
        ]
      },
      "config_schema": {
        "type": "object",
        "properties": {
          "login": {
            "description": "API Login",
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          }
        },
        "required": [
          "login"
        ]
      },
      "payload_format": "raw",
      "payload_field": "password",
      "setup": {
        "label": "Login and password",
        "fields": [
          {
            "description": null,
            "key": "login",
            "label": "API Login",
            "options": null,
            "placeholder": "login@example.com",
            "required": true,
            "secret": false,
            "type": "text"
          },
          {
            "description": null,
            "key": "password",
            "label": "API Password",
            "options": null,
            "placeholder": null,
            "required": true,
            "secret": true,
            "type": "secret"
          }
        ],
        "description": "DataForSEO uses HTTP Basic authentication with the API login as username and API password as password. Named actions cover live SERP and keyword endpoints. Obtain the API login and API password from DataForSEO API access."
      }
    }
  ],
