{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "required": [
        "mode",
        "details"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/details"
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "preview"
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "commit"
            }
          }
        }
      ],
      "x-server-refinements": {
        "owner": "server",
        "rules": [
          "current-account-budget"
        ]
      }
    }
  },
  "$defs": {
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "amount",
        "tags"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8,
          "pattern": "^[a-z]+$"
        },
        "amount": {
          "type": "number",
          "minimum": 1,
          "exclusiveMaximum": 10,
          "multipleOf": 0.5
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
